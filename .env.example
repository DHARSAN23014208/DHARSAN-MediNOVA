# ==============================================================================
# MediNova Clinical AI - Environment Configuration (.env)
# ==============================================================================

# Developer Master Security Key for /developer/patient-records
DEV_ACCESS_KEY=your_secure_developer_master_key_here

# Authorized Developer Email (Strict Case-Insensitive Match)
AUTHORIZED_DEV_EMAIL=your_developer_email@example.com

# ------------------------------------------------------------------------------
# Google Sheets Silent Background Logging Configuration
# Target Spreadsheet: MediNova_Patient_Records (Private - Shared with your developer email)
# ------------------------------------------------------------------------------

# Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Service Account Credentials (Option 1: Path to local service_account.json file)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Service Account Credentials (Option 2: Raw JSON string for Cloud environments like Render/Docker)
# GOOGLE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", ...}'

# ------------------------------------------------------------------------------
# SMTP Notification & Two-Factor Delivery (Optional - for Developer OTP & Clinic Appointment Alerts)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_clinic_notification_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Flask Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_random_flask_secret_key_minimum_32_chars

# ------------------------------------------------------------------------------
# Smart Lab Report Scanner — Optional Multimodal Vision Cloud APIs
# (Local OCR & PDF parsing runs automatically if keys are omitted)
# ------------------------------------------------------------------------------
# Google Gemini Multimodal Vision (e.g. gemini-1.5-flash)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI Vision (e.g. gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Public Verification URL & Cryptographic Integrity Signature
# ------------------------------------------------------------------------------
# Canonical public base URL for printed QR codes (e.g. https://medinova.onrender.com)
PUBLIC_BASE_URL=http://localhost:5000

# Secret salt for HMAC-SHA256 clinical verification seals
REPORT_SIGNING_SECRET=your_random_report_signing_secret_here

